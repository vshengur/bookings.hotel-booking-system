# Consul Secrets Configuration Template
# Copy this file to secrets.env and fill in your values
# secrets.env is gitignored for security

# ============================================
# IMPORTANT: JWT Secret
# ============================================
# If not provided, a random JWT_SECRET will be auto-generated on first run
# For production, you should provide a strong secret here
# JWT_SECRET=your-strong-jwt-secret-at-least-64-chars-long

# ============================================
# Database Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=auth_service

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://localhost:8081/api/auth/callback

# ============================================
# Application Configuration
# ============================================
RUN_MODE=dev
