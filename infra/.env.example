# Rabbit MQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Consul Secrets Configuration
# Leave JWT_SECRET empty for auto-generation in dev environment
# For production, generate a strong secret: openssl rand -base64 64
JWT_SECRET=

# Database Configuration (for services using Consul)
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=auth_service

# Google OAuth Configuration (for auth-service)
# Get your credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://localhost:8081/api/auth/callback

# Application Configuration
RUN_MODE=dev
